                </tr>
                <tr>
                    <td><strong>Reporting System</strong></td>
                    <td>One-click CSV exports for Students, Faculty, and Logs</td>
                    <td><span class="highlight-badge">Completed</span></td>
                </tr>
                <tr>
                    <td><strong>Mandatory Submission Link</strong></td>
                    <td>Task reference integrated for freeinternships.in/blog/</td>
                    <td><span class="highlight-badge">Completed</span></td>
                </tr>
            </tbody>
        </table>

        <p><strong>Official Submission Links:</strong></p>
        <ul>
            <li><strong>Live Deployed Site:</strong> <code>https://your-username.github.io/college-pro-system/</code></li>
            <li><strong>GitHub Repository:</strong> <code>https://github.com/your-username/college-pro-system</code></li>
            <li><strong>Video Demonstration:</strong> <code>https://youtu.be/your-video-link</code></li>
            <li><strong>Blog Submission Portal:</strong> <a href="https://www.freeinternships.in/blog/">https://www.freeinternships.in/blog/</a></li>
        </ul>

    </div>

    <!-- Client-Side Word (.doc) Generation Script -->
    <script>
        function exportToWordDoc() {
            var header = "<html xmlns:o='urn:schemas-microsoft-com:office:office' " +
                         "xmlns:w='urn:schemas-microsoft-com:office:word' " +
                         "xmlns='http://www.w3.org/TR/REC-html40'><head><meta charset='utf-8'>" +
                         "<style>" +
                         "@page Section1 {size:8.5in 11.0in; margin:1.0in 1.0in 1.0in 1.0in; mso-header-margin:0.5in; mso-footer-margin:0.5in; mso-paper-source:0;}" +
                         "div.Section1 {page:Section1;}" +
                         "body {font-family:Calibri, Arial, sans-serif; font-size:11pt; line-height:1.5; color:#222222;}" +
                         "h1.doc-title {color:#1A56DB; font-size:22pt; font-weight:bold; border-bottom:2pt solid #1A56DB; padding-bottom:6pt;}" +
                         "h2.section-header {color:#1A56DB; font-size:14pt; font-weight:bold; border-bottom:1px solid #CBD5E1; padding-bottom:3pt; margin-top:16pt;}" +
                         "h3.sub-header {color:#1E293B; font-size:12pt; font-weight:bold; margin-top:10pt;}" +
                         "table {width:100%; border-collapse:collapse; margin-bottom:12pt;}" +
                         "th {background-color:#1A56DB; color:#ffffff; font-weight:bold; padding:6pt 8pt; border:1px solid #1A56DB; text-align:left;}" +
                         "td {padding:6pt 8pt; border:1px solid #CBD5E1; font-size:10pt;}" +
                         ".meta-table td {background-color:#F8FAFC; border:1px solid #E2E8F0;}" +
                         ".diagram-box {font-family:Consolas, monospace; background-color:#F1F5F9; border-left:4px solid #1A56DB; padding:8pt; margin:8pt 0; font-size:9.5pt;}" +
                         "</style></head><body><div class='Section1'>";
            
            var content = document.querySelector('.Section1').innerHTML;
            var footer = "</div></body></html>";
            var sourceHTML = header + content + footer;

            var blob = new Blob(['\ufeff' + sourceHTML], {
                type: 'application/msword'
            });

            var url = URL.createObjectURL(blob);
            var downloadLink = document.createElement("a");
            document.body.appendChild(downloadLink);
            downloadLink.href = url;
            downloadLink.download = 'CollegePro_Project_Report_WD_COL_001.doc';
            downloadLink.click();
            document.body.removeChild(downloadLink);
        }
    </script>
</body>
</html>