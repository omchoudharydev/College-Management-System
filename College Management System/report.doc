            padding: 0;
        }

        /* Screen Preview Controls */
        .no-print-bar {
            background-color: #1A56DB;
            color: #ffffff;
            padding: 14px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-family: sans-serif;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        }
        .download-btn {
            background-color: #ffffff;
            color: #1A56DB;
            border: none;
            padding: 8px 18px;
            font-size: 13px;
            font-weight: 700;
            border-radius: 4px;
            cursor: pointer;
            text-decoration: none;
        }
        .download-btn:hover {
            background-color: #DBEAFE;
        }

        /* Document Typography */
        h1.doc-title {
            color: #1A56DB;
            font-size: 24pt;
            font-weight: bold;
            margin: 0 0 6pt 0;
            text-transform: uppercase;
            letter-spacing: -0.5px;
            border-bottom: 2pt solid #1A56DB;
            padding-bottom: 8pt;
        }

        .meta-table {
            width: 100%;
            border-collapse: collapse;
            margin: 14pt 0 20pt 0;
            background-color: #F8FAFC;
        }
        .meta-table td {
            padding: 6pt 10pt;
            font-size: 10pt;
            border: 1px solid #E2E8F0;
        }
        .meta-label {
            font-weight: bold;
            color: #475569;
            width: 25%;
        }
        .meta-value {
            color: #0F172A;
        }

        h2.section-header {
            color: #1A56DB;
            font-size: 14pt;
            font-weight: bold;
            margin-top: 18pt;
            margin-bottom: 8pt;
            border-bottom: 1px solid #CBD5E1;
            padding-bottom: 3pt;
        }

        h3.sub-header {
            color: #1E293B;
            font-size: 12pt;
            font-weight: bold;
            margin-top: 12pt;
            margin-bottom: 4pt;
        }

        p {
            margin: 0 0 8pt 0;
            text-align: justify;
        }

        ul {
            margin: 4pt 0 10pt 20pt;
            padding: 0;
        }
        li {
            margin-bottom: 4pt;
        }

        /* Tables */
        table.content-table {
            width: 100%;
            border-collapse: collapse;
            margin: 12pt 0 16pt 0;
        }
        table.content-table th {
            background-color: #1A56DB;
            color: #ffffff;
            font-weight: bold;
            font-size: 10.5pt;
            padding: 7pt 10pt;
            text-align: left;
            border: 1px solid #1A56DB;
        }
        table.content-table td {
            font-size: 10pt;
            padding: 7pt 10pt;
            border: 1px solid #CBD5E1;
            vertical-align: top;
        }
        table.content-table tr:nth-child(even) {
